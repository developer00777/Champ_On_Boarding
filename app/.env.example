# MongoDB connection (Railway-hosted in prod, docker-compose locally)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=champonboard

# Redis (used for session/cache; docker-compose locally)
REDIS_URL=redis://localhost:6379

# OpenRouter — OCR via Gemini Flash. Model id is config (PRD §8).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash

# 32-byte hex key for AES-256-GCM Aadhaar encryption: `openssl rand -hex 32`
ENCRYPTION_KEY=

# Public origin used in candidate links/emails
PUBLIC_BASE_URL=http://localhost:5173

# Resend for transactional email; leave empty in dev to log emails to console
RESEND_API_KEY=
MAIL_FROM=ChampHR <onboarding@offer.championsmail.com>
# Optional: separate mailbox for offer-letter emails on the same verified
# domain. Falls back to MAIL_FROM if unset.
OFFER_MAIL_FROM=Offers <offers@offer.championsmail.com>
# Mailbox for BGV verification requests and their reminders. BGV is the only
# mail this platform sends to people who never opted in — HR desks at previous
# employers — so it sends from its OWN subdomain: a spam complaint there cannot
# drag down the reputation of offer.championsmail.com, which carries every
# offer letter. Optional: falls back to bgv@bgv.<root domain of MAIL_FROM>,
# which is the same address.
#
# Before this will send, bgv.championsmail.com must be added as a domain in
# Resend and its DKIM/SPF/DMARC records published. To receive the employer's
# reply, add an inbound (MX) route for that domain too and point it at
# {PUBLIC_BASE_URL}/webhooks/resend — replies to bgv@ are what the verification
# table is filled in from.
BGV_MAIL_FROM=Champion BGV <bgv@bgv.championsmail.com>
# Mailbox for offboarding mail (exit forms, clearances, IT access block, final
# handover), so a resignation does not arrive from the joiner mailbox. Optional:
# falls back to offboarding@<MAIL_FROM's domain>, which is the same address.
EXIT_MAIL_FROM=ChampOnboard <offboarding@offer.championsmail.com>
# Signing secret ("whsec_...") for the Resend webhook — Resend dashboard →
# Webhooks → add endpoint → {PUBLIC_BASE_URL}/webhooks/resend, subscribe to
# the email.* events → copy the Signing Secret shown after creation.
RESEND_WEBHOOK_SECRET=

# ── BGV reminder sweep ────────────────────────────────────────────────────────
# A long-running server (Docker, Railway) chases unanswered BGV requests from
# its own in-process ticker and needs nothing here. Set to "off" to disable
# that ticker — e.g. when an external scheduler owns the job.
BGV_REMINDER_TICKER=
# Bearer token for GET/POST /api/cron/bgv-reminders, the external trigger for
# the same sweep. REQUIRED on Vercel and anywhere the app scales to zero, since
# a serverless function has no process to hold the ticker. Leave blank and the
# endpoint stays disabled (503) rather than open. Generate: `openssl rand -hex 32`
CRON_SECRET=

# Optional: overrides for scripts/seed.ts and scripts/reset-admin.ts (defaults: deep@championsmail.com / champ-admin-2026)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Restricts /admin (HR login + dashboard) to the office/VPN IPs listed in
# lib/server/ip-allowlist.ts. Candidate-facing routes (/c/[token]) and
# webhooks are never affected. Update the IP list itself in that file, not
# here. Values:
#   log      (default if unset) — logs would-be-blocked IPs, never blocks.
#             Use this first to confirm no legitimate office IP is missing.
#   enforce  — actually returns 403 for IPs not on the list.
#   off      — disables the check entirely.
ADMIN_IP_ALLOWLIST_MODE=log

# REQUIRED on Railway for the allowlist above (and the existing login rate
# limiter) to see the real visitor IP instead of Railway's proxy IP —
# adapter-node only trusts X-Forwarded-For when told to. Not needed on
# Vercel (its adapter always reads X-Forwarded-For from the trusted edge).
ADDRESS_HEADER=x-forwarded-for

# adapter-node caps request bodies at 512 KB by default, which rejects every
# real document upload with a 413. Must be at least MAX_FILE_BYTES
# (shared/matrix.ts). Not read by the Vercel adapter, which has its own ~4.5 MB
# serverless cap — see DEPLOY_VERCEL.md.
BODY_SIZE_LIMIT=150M

# Alert email — sent to HR when a candidate submits documentation.
# The link creator is always alerted; this is an additional catch-all address.
ONBOARDING_ALERT_EMAIL=

# Onboarding concern person email — alerted after HR approves a candidate
# to create the employee code. Leave blank to disable.
ONBOARDING_CONCERN_EMAIL=

# ── Twilio WhatsApp Business API ──────────────────────────────────────────────
# Set all of these in Railway → Variables panel before going live.
# Console: https://console.twilio.com → Account → API keys & tokens (for the
# API Key/Secret pair) and Messaging → Senders → WhatsApp Senders (for the
# approved sender number).
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Approved WhatsApp sender, "whatsapp:+<E.164>" — e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# ContentSid ("HX...") of each approved Content Template — Console →
# Messaging → Content Template Builder. All four must be Meta-approved
# (category: Utility) before they will actually send.
TWILIO_TEMPLATE_WELCOME=
TWILIO_TEMPLATE_OFFER=
TWILIO_TEMPLATE_APPROVED=
# Media-header template for the personalized "Welcome to the Champions
# Family" image sent on approval — see lib/server/whatsapp.ts sendWelcomeCardWA
# and lib/server/welcome-card.ts for how the image itself is generated.
TWILIO_TEMPLATE_WELCOME_CARD=

